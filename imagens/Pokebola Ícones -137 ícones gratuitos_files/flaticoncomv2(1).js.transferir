html, body {\n    width: 300px;\n    height: 250px;\n    background: transparent;\n    overflow: hidden;\n    font-family: \'Segoe UI\', Roboto, Arial, sans-serif;\n  }\n\n  .banner {\n    width: 300px;\n    height: 250px;\n    background: transparent;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-decoration: none;\n  }\n\n  .card {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    padding: 26px 30px;\n  }\n\n  .headline {\n    color: #111827;\n    font-size: 26px;\n    font-weight: 800;\n    line-height: 1.15;\n    text-align: center;\n    margin-bottom: 6px;\n  }\n\n  .headline .accent {\n    color: #16a34a;\n  }\n\n  .subline {\n    color: #4b5563;\n    font-size: 13px;\n    font-weight: 500;\n    text-align: center;\n    margin-bottom: 22px;\n    letter-spacing: 0.3px;\n  }\n\n  .btn {\n    position: relative;\n    display: inline-flex;\n    align-items: center;\n    gap: 12px;\n    padding: 16px 40px;\n    font-size: 20px;\n    font-weight: 600;\n    color: #ffffff;\n    letter-spacing: 0.4px;\n    background: #16a34a;\n    border-radius: 12px;\n    box-shadow: 0 8px 22px rgba(22, 163, 74, 0.35);\n    overflow: hidden;\n    transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;\n  }\n\n  /* Subtle shine sweep */\n  .btn::after {\n    content: "";\n    position: absolute;\n    top: 0;\n    left: -60%;\n    width: 40%;\n    height: 100%;\n    background: linear-gradient(120deg, transparent, rgba(255,255,255,0.4), transparent);\n    transform: skewX(-20deg);\n    animation: shine 3s ease-in-out infinite;\n  }\n\n  @keyframes shine {\n    0%   { left: -60%; }\n    45%  { left: 130%; }\n    100% { left: 130%; }\n  }\n\n  .banner:hover .btn {\n    transform: translateY(-2px);\n    background: #15803d;\n    box-shadow: 0 12px 28px rgba(22, 163, 74, 0.5);\n  }\n\n  .btn svg {\n    width: 20px;\n    height: 20px;\n    fill: #ffffff;\n    position: relative;\n    z-index: 1;\n  }\n\n  .btn span {\n    position: relative;\n    z-index: 1;\n  }\n</style>\n</head>\n<body>\n  <a class="banner" href="{{LINK}}" target="_blank" rel="noopener">\n    <div class="card">\n      <div class="headline">¡Descárgalo <span class="accent">Ya!</span></div>\n      <div class="subline">Rápido · Seguro · Gratis</div>\n      <div class="btn">\n        <svg viewBox="0 0 24 24"><path d="M12 3v10.55l3.29-3.28 1.41 1.41L12 17.4l-4.7-4.72 1.41-1.41L12 13.55V3zM5 19h14v2H5z"/></svg>\n        <span>Descargar</span>\n      </div>\n    </div>\n  </a>\n</body>\n</html>\n',"300x600":'<!DOCTYPE html>\n<html lang="es">\n<head>\n<meta charset="UTF-8">\n<meta name="viewport" content="width=300, initial-scale=1.0">\n<title>Banner 300x600</title>\n<style>\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n\n  html, body {\n    width: 300px;\n    height: 600px;\n    background: transparent;\n    overflow: hidden;\n    font-family: \'Segoe UI\', Roboto, Arial, sans-serif;\n  }\n\n  .banner {\n    width: 300px;\n    height: 600px;\n    background: transparent;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    text-decoration: none;\n    padding: 0 16px;\n  }\n\n  .card {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    padding: 36px 28px;\n  }\n\n  .badge {\n    display: inline-block;\n    padding: 6px 16px;\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: 1.5px;\n    color: #16a34a;\n    text-transform: uppercase;\n    border: 1px solid rgba(22, 163, 74, 0.5);\n    border-radius: 30px;\n    margin-bottom: 26px;\n  }\n\n  .headline {\n    color: #111827;\n    font-size: 40px;\n    font-weight: 800;\n    line-height: 1.1;\n    text-align: center;\n    margin-bottom: 14px;\n  }\n\n  .headline .accent {\n    color: #16a34a;\n  }\n\n  .subline {\n    color: #4b5563;\n    font-size: 16px;\n    font-weight: 500;\n    line-height: 1.5;\n    text-align: center;\n    margin-bottom: 40px;\n  }\n\n  .features {\n    list-style: none;\n    margin-bottom: 44px;\n    text-align: center;\n  }\n  .features li {\n    color: #374151;\n    font-size: 15px;\n    font-weight: 500;\n    margin: 12px 0;\n  }\n  .features li::before {\n    content: "✓";\n    color: #16a34a;\n    font-weight: 800;\n    margin-right: 8px;\n  }\n\n  .btn {\n    position: relative;\n    display: inline-flex;\n    align-items: center;\n    gap: 12px;\n    padding: 20px 48px;\n    font-size: 22px;\n    font-weight: 600;\n    color: #ffffff;\n    letter-spacing: 0.4px;\n    background: #16a34a;\n    border-radius: 12px;\n    box-shadow: 0 8px 22px rgba(22, 163, 74, 0.35);\n    overflow: hidden;\n    transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease;\n  }\n\n  .btn::after {\n    content: "";\n    position: absolute;\n    top: 0;\n    left: -60%;\n    width: 40%;\n    height: 100%;\n    background: linear-gradient(120deg, transparent, rgba(255,255,255,0.4), transparent);\n    transform: skewX(-20deg);\n    animation: shine 3s ease-in-out infinite;\n  }\n\n  @keyframes shine {\n    0%   { left: -60%; }\n    45%  { left: 130%; }\n    100% { left: 130%; }\n  }\n\n  .banner:hover .btn {\n    transform: translateY(-2px);\n    background: #15803d;\n    box-shadow: 0 12px 28px rgba(22, 163, 74, 0.5);\n  }\n\n  .btn svg {\n    width: 22px;\n    height: 22px;\n    fill: #ffffff;\n    position: relative;\n    z-index: 1;\n  }\n\n  .btn span {\n    position: relative;\n    z-index: 1;\n  }\n</style>\n</head>\n<body>\n  <a class="banner" href="{{LINK}}" target="_blank" rel="noopener">\n    <div class="card">\n      <span class="badge">Exclusivo</span>\n      <div class="headline">¡Descárgalo<br><span class="accent">Ya!</span></div>\n      <div class="subline">La mejor experiencia<br>a un solo clic de distancia</div>\n      <ul class="features">\n        <li>100% Gratis</li>\n        <li>Rápido y Seguro</li>\n        <li>Sin Registro</li>\n      </ul>\n      <div class="btn">\n        <svg v