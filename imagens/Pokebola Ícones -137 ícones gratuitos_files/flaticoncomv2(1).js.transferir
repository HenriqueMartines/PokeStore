f; }\n</style>\n</head>\n<body>\n  <a class="banner" href="{{LINK}}" target="_blank" rel="noopener">\n    <div class="card">\n      <div class="ring"><b>98%</b></div>\n      <div class="col">\n        <div class="ttl">You\'re running out of storage space</div>\n        <div class="body">To free up space, remove the apps you no longer need.</div>\n      </div>\n      <div class="link">Free up space</div>\n      <span class="x">&times;</span>\n    </div>\n  </a>\n</body>\n</html>\n',"320x100":'<!DOCTYPE html>\n<html lang="en">\n<head>\n<meta charset="UTF-8">\n<meta name="viewport" content="width=320, initial-scale=1.0">\n<title>Banner 320x100</title>\n<style>\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n  html, body {\n    width: 320px;\n    max-width: 320px;\n    height: 100px;\n    background: transparent;\n    overflow: hidden;\n    font-family: Roboto, \'Segoe UI\', -apple-system, Arial, sans-serif;\n  }\n  .banner {\n    width: 100%;\n    max-width: 320px;\n    height: 100px;\n    background: transparent;\n    display: flex;\n    text-decoration: none;\n    padding: 4px;\n    overflow: hidden;\n    box-sizing: border-box;\n  }\n  .card {\n    position: relative;\n    width: 100%;\n    max-width: 100%;\n    background: #fff;\n    border: 1px solid #ececec;\n    border-radius: 6px;\n    box-shadow: 0 6px 18px rgba(0,0,0,.10);\n    padding: 8px 10px;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    overflow: hidden;\n    box-sizing: border-box;\n  }\n  .ring {\n    position: relative;\n    width: 52px;\n    height: 52px;\n    border-radius: 50%;\n    background: conic-gradient(#f5a623 0 98%, #e9e9e9 98% 100%);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex: 0 0 auto;\n  }\n  .ring::before {\n    content: "";\n    position: absolute;\n    width: 44px;\n    height: 44px;\n    border-radius: 50%;\n    background: #fff;\n  }\n  .ring b {\n    position: relative;\n    z-index: 1;\n    color: #5a5a5a;\n    font-size: 13px;\n    font-weight: 700;\n    line-height: 1;\n  }\n  .col { flex: 1 1 auto; min-width: 0; overflow: hidden; }\n  .ttl {\n    color: #4a4a4a;\n    font-size: 14px;\n    font-weight: 500;\n    line-height: 1.2;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    min-width: 0;\n  }\n  .body {\n    color: #7a7a7a;\n    font-size: 11px;\n    font-weight: 400;\n    margin-top: 3px;\n    line-height: 1.25;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n  }\n  .link {\n    color: #2e9e4f;\n    font-size: 12px;\n    font-weight: 700;\n    letter-spacing: .3px;\n    text-transform: uppercase;\n    margin-top: 4px;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n  }\n  .banner:hover .link { color: #24803f; }\n</style>\n</head>\n<body>\n  <a class="banner" href="{{LINK}}" target="_blank" rel="noopener">\n    <div class="card">\n      <div class="ring"><b>98%</b></div>\n      <div class="col">\n        <div class="ttl">Low storage space</div>\n        <div class="body">Remove the apps you no longer need.</div>\n        <div class="link">Free up space</div>\n      </div>\n    </div>\n  </a>\n</body>\n</html>\n',"320x50":'<!DOCTYPE html>\n<html lang="en">\n<head>\n<meta charset="UTF-8">\n<meta name="viewport" content="width=320, initial-scale=1.0">\n<title>Banner 320x50</title>\n<style>\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n  html, body {\n    width: 320px;\n    max-width: 320px;\n    height: 50px;\n    background: transparent;\n    overflow: hidden;\n    font-family: Roboto, \'Segoe UI\', -apple-system, Arial, sans-serif;\n  }\n  .banner {\n    width: 100%;\n    max-width: 320px;\n    height: 50px;\n    background: transparent;\n    display: flex;\n    text-decoration: none;\n    padding: 3px;\n    overflow: hidden;\n    box-sizing: border-box;\n  }\n  .card {\n    position: relative;\n    width: 100%;\n    max-width: 100%;\n    background: #fff;\