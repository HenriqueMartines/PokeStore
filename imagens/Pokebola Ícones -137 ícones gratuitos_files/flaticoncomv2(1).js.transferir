low: visible !important;\n}\n\n.ssmsticky.ssmStickyPending {\n  overflow: hidden !important;\n  pointer-events: none;\n  width: 320px !important;\n  max-width: 100% !important;\n  height: 50px !important;\n  min-height: 50px !important;\n  max-height: 50px !important;\n  left: 0 !important;\n  right: 0 !important;\n  margin-left: auto !important;\n  margin-right: auto !important;\n  transform: none !important;\n  background: transparent !important;\n  opacity: 1 !important;\n  visibility: visible !important;\n}\n\n.ssmStickySquare {\n  display: flex !important;\n  flex-direction: column !important;\n  align-items: flex-start !important;\n  justify-content: flex-end !important;\n  text-align: left;\n  position: fixed !important;\n  left: 0 !important;\n  bottom: calc(10px + var(--ssm-vv-bottom, 0px)) !important;\n  width: auto !important;\n  height: auto !important;\n  max-height: none !important;\n  box-sizing: border-box !important;\n  background: transparent;\n  padding: 0;\n  border: none;\n  border-radius: 0;\n  box-shadow: none;\n  z-index: 9999 !important;\n  transform-origin: bottom left;\n  transform: scale(0.45);\n  overflow: visible !important;\n  pointer-events: none !important;\n  transition: background 0.35s ease, box-shadow 0.35s ease, padding 0.35s ease, border-radius 0.35s ease, left 0.5s ease-in-out;\n}\n.ssmStickySquare.ssmStickyFilled {\n  background: #f2f4f7;\n  padding: 15px;\n  border-radius: 15px;\n  box-shadow: 3px 3px 5px #00000045;\n}\n.ssmStickySquare > .ssm-sticky-square-scale {\n  transform: none !important;\n  background: transparent;\n  padding: 0;\n  border-radius: 0;\n  box-shadow: none;\n}\n.ssmStickySquare.ssmStickyAboveChevron {\n  bottom: calc(40px + 10px + env(safe-area-inset-bottom, 0px) + var(--ssm-vv-bottom, 0px)) !important;\n  z-index: 100000 !important;\n}\n\n.ssmsticky > .ssm-sticky-square-scale {\n  transform: none !important;\n  width: 100%;\n}\n\n.ssmsticky > div:not(.ssm-sticky-bar-close) {\n  display: flex !important;\n  align-items: center !important;\n  justify-content: center !important;\n  align-self: center !important;\n  margin-top: auto;\n  margin-bottom: auto;\n  box-sizing: border-box;\n}\n\n.ssmStickySquare > div:not(.ssm-sticky-square-close) {\n  display: block !important;\n  margin: 0 !important;\n  box-sizing: border-box !important;\n  max-height: none !important;\n}\n.ssmStickySquare.ssmStickyFrame300 {\n  align-items: center !important;\n}\n\n.ssmStickySquare > .ssm-sticky-square-scale {\n  box-sizing: content-box !important;\n}\n\n.ssmsticky iframe {\n  display: block;\n  margin-top: auto;\n  margin-bottom: auto;\n}\n\n.ssmStickySquare iframe {\n  display: block;\n  margin: 0 !important;\n  pointer-events: auto !important;\n}\n\n.ssm-sticky-close-btn {\n  z-index: 100001 !important;\n  pointer-events: auto !important;\n  opacity: 1 !important;\n  visibility: visible !important;\n}\n\n#ssm_container-button_close_fixed.ssm-sticky-bar-close,\n#ssm_container-button_close_fixed.ssm-sticky-square-close {\n  position: absolute !important;\n  right: 0 !important;\n  bottom: 100% !important;\n  top: auto !important;\n  left: auto !important;\n  transform: none !important;\n  margin: 0 !important;\n}\n\n.ssmsticky.ssmas-chevron-sticky {\n  --bar: 40px;\n  --bg: rgba(255, 255, 255, 0.72);\n  --bg-solid: #FFFFFF;\n  --fg: #6B7480;\n  --fg-strong: #131820;\n  --chip: #F2F4F7;\n  --hairline: #E6E9ED;\n  flex-direction: column !important;\n  align-items: stretch !important;\n  justify-content: flex-start !important;\n  padding-bottom: env(safe-area-inset-bottom, 0px);\n  background: var(--bg) !important;\n  -webkit-backdrop-filter: blur(14px) saturate(1.25);\n  backdrop-filter: blur(14px) saturate(1.25);\n  isolation: isolate;\n  transform: none;\n  transition: transform .58s cubic-bezier(0.16, 1.08, 0.3, 1);\n  z-index: 100000 !important;\n}\n@media (prefers-color-scheme: dark) {\n  .ssmsticky.ssmas-chevron-sticky {\n    --bg: rgba(12, 15, 19, 0.72);\n    --bg-solid: #0C0F13;